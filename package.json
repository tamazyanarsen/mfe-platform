{
  "name": "mfe-platform",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "experiments"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "ci": "bun run check:boundaries && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@playwright/test": "^1.55.0",
    "@rsbuild/core": "^2.2.14",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
